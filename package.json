  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.4",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "next": "16.2.4",
    "next-auth": "^4.24.14",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.86.0"
